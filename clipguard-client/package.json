{
  "name": "asklens-clipguard-client",
  "version": "1.0.0",
  "description": "Watches the clipboard and checks copied links against live Telegraph miners before you paste them anywhere.",
  "type": "module",
  "main": "desktop-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "check": "node --check desktop-main.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.asklens.clipguard",
    "productName": "AskLens Clip Guard",
    "files": [
      "desktop-main.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AskLens Clip Guard"
    }
  }
}
